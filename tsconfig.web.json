{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "outDir": "./out",
    "rootDir": ".",
    "composite": true,
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*"
  ]
}
